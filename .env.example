# =====================================================================
# AI-POWERED LESSON CREATION TOOL - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Primary AI / LLM Provider: Google Gemini API (Recommended)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternate Google API Key variable name
GOOGLE_API_KEY=

# Preferred Gemini model: gemini-2.0-flash, gemini-1.5-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# 2. YouTube Data API v3 (Optional)
# Get a key at: https://console.cloud.google.com/apis/credentials (YouTube Data API v3)
# If omitted, the tool automatically falls back to reliable web-based video discovery.
YOUTUBE_API_KEY=

# 3. Web Search APIs (Optional)
# DuckDuckGo search works out of the box with zero configuration!
# Optional alternative search APIs if you have custom accounts:
TAVILY_API_KEY=
SERPER_API_KEY=

# 4. Database Configuration
DATABASE_PATH=lessons.db

# 5. Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

